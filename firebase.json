{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "cermatify",
          "appId": "1:1083109793751:android:f1aa56860023933c093592",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "cermatify",
          "appId": "1:1083109793751:ios:f41185c43cc2b0a2093592",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "cermatify",
          "appId": "1:1083109793751:ios:f41185c43cc2b0a2093592",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "cermatify",
          "configurations": {
            "android": "1:1083109793751:android:f1aa56860023933c093592",
            "ios": "1:1083109793751:ios:f41185c43cc2b0a2093592",
            "macos": "1:1083109793751:ios:f41185c43cc2b0a2093592",
            "web": "1:1083109793751:web:51679ccbb6f94e95093592",
            "windows": "1:1083109793751:web:ace872e37247dc0d093592"
          }
        }
      }
    }
  }
}
